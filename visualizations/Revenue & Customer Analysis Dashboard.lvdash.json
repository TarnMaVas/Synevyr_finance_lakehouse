{
  "datasets": [
    {
      "name": "top_customers",
      "displayName": "Top 10 Customers by Net Revenue",
      "config": {
        "version": "1.1",
        "source": "SELECT\n  c_name AS customer_name,\n  total_net_revenue,\n  (SELECT SUM(total_net_revenue) FROM workspace.default.finance_gold_customer_revenue) AS grand_total_revenue\nFROM workspace.default.finance_gold_customer_revenue ORDER BY total_net_revenue DESC LIMIT 10",
        "dimensions": [
          {
            "name": "customer_name",
            "expr": "customer_name",
            "displayName": "Customer Name"
          },
          {
            "name": "grand_total_revenue",
            "expr": "grand_total_revenue"
          }
        ],
        "measures": [
          {
            "name": "net_revenue",
            "expr": "SUM(total_net_revenue)",
            "displayName": "Net Revenue",
            "format": {
              "type": "currency",
              "currencyCode": "USD",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          },
          {
            "name": "revenue_share",
            "expr": "MEASURE(net_revenue) / ANY_VALUE(grand_total_revenue)",
            "displayName": "Revenue Share",
            "format": {
              "type": "percentage",
              "decimalPlaces": {
                "type": "exact",
                "places": 4.0
              }
            }
          }
        ]
      }
    },
    {
      "name": "revenue_1997",
      "displayName": "1997 Revenue Analysis Three Methods",
      "config": {
        "version": "1.1",
        "source": "SELECT\n  'Gross Extended Price' AS metric_name,\n  gross_revenue AS revenue_value\nFROM workspace.default.finance_gold_yearly_revenue WHERE year = 1997 UNION ALL SELECT\n  'Net of Discount' AS metric_name,\n  net_revenue_discount AS revenue_value\nFROM workspace.default.finance_gold_yearly_revenue WHERE year = 1997 UNION ALL SELECT\n  'Net of Discount & Tax' AS metric_name,\n  net_revenue_discount_tax AS revenue_value\nFROM workspace.default.finance_gold_yearly_revenue WHERE year = 1997",
        "dimensions": [
          {
            "name": "metric_name",
            "expr": "metric_name",
            "displayName": "Revenue Metric"
          }
        ],
        "measures": [
          {
            "name": "revenue_value",
            "expr": "SUM(revenue_value)",
            "displayName": "Revenue",
            "format": {
              "type": "currency",
              "currencyCode": "USD",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          }
        ]
      }
    },
    {
      "name": "market_segment_trends",
      "displayName": "Market Segment Avg Order Value Trends",
      "config": {
        "version": "1.1",
        "source": "workspace.default.finance_gold_segment_yearly_order_value",
        "dimensions": [
          {
            "name": "year",
            "expr": "year",
            "displayName": "Year"
          },
          {
            "name": "c_mktsegment",
            "expr": "c_mktsegment",
            "displayName": "Market Segment"
          }
        ],
        "measures": [
          {
            "name": "avg_order_value",
            "expr": "AVG(avg_order_value)",
            "displayName": "Avg Order Value",
            "format": {
              "type": "currency",
              "currencyCode": "USD",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          }
        ]
      }
    },
    {
      "name": "top_suppliers",
      "displayName": "Top 5 Suppliers by Revenue",
      "config": {
        "version": "1.1",
        "source": "SELECT\n  s_name AS supplier_name,\n  supplier_net_revenue,\n  avg_discount\nFROM workspace.default.finance_gold_supplier_performance ORDER BY supplier_net_revenue DESC LIMIT 5",
        "dimensions": [
          {
            "name": "supplier_name",
            "expr": "supplier_name",
            "displayName": "Supplier Name"
          }
        ],
        "measures": [
          {
            "name": "total_revenue",
            "expr": "SUM(supplier_net_revenue)",
            "displayName": "Total Revenue",
            "format": {
              "type": "currency",
              "currencyCode": "USD",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          },
          {
            "name": "avg_discount",
            "expr": "AVG(avg_discount)",
            "displayName": "Avg Discount",
            "format": {
              "type": "percentage",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          }
        ]
      }
    }
  ],
  "pages": [
    {
      "name": "97d4b9be",
