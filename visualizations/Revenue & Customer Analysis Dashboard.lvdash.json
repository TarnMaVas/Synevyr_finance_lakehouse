                      "name": "customer_name",
                      "expression": "`customer_name`"
                    },
                    {
                      "name": "measure(net_revenue)",
                      "expression": "MEASURE(`net_revenue`)"
                    },
                    {
                      "name": "measure(revenue_share)",
                      "expression": "MEASURE(`revenue_share`)"
                    }
